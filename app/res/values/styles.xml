<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The light background already in the window: opening the home screen never flashes another color. -->
    <color name="home_background">#EBEBF0</color>

    <style name="FreeMyTV.Home" parent="@android:style/Theme.DeviceDefault.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/home_background</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:colorBackgroundCacheHint">@null</item>
    </style>
    <style name="GenreScroll">
        <!-- Initialize the native scrollbar drawable during View construction, also on API28. -->
        <item name="android:scrollbars">vertical</item>
        <item name="android:scrollbarStyle">insideOverlay</item>
        <item name="android:fadeScrollbars">true</item>
        <item name="android:scrollbarDefaultDelayBeforeFade">800</item>
        <item name="android:scrollbarFadeDuration">250</item>
        <item name="android:scrollbarThumbVertical">@drawable/genre_scrollbar_thumb</item>
        <item name="android:scrollbarTrackVertical">@android:color/transparent</item>
        <item name="android:scrollbarSize">3dp</item>
    </style>
    <style name="SearchInput" parent="@android:style/Widget.DeviceDefault.EditText">
        <item name="android:textCursorDrawable">@drawable/search_cursor</item>
    </style>
    <style name="ScreensaverPreview" parent="@android:style/Theme.Translucent.NoTitleBar.Fullscreen">
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
